{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Menu exchange file entry (calderone-menu/1, from GET /api/menus/export or the menu-planner agent)",
  "description": "A file holds one such object or a list of them. Unlike data/menus/<id>.json there is no owner/household: the importer picks the space. Recipe items carry the title too, so they can be matched on another server; a recipe that cannot be found is imported as a text dish.",
  "type": "object",
  "required": ["format", "name", "weeks", "meals", "items"],
  "properties": {
    "format": { "const": "calderone-menu/1" },
    "id": { "type": ["string", "null"], "pattern": "^[a-f0-9]{8,64}$", "description": "Kept on import if free; an existing id is skipped." },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "notes": { "type": "string" },
    "start": { "type": "string", "format": "date", "description": "Monday of week 1 (another day is moved back to its Monday)." },
    "weeks": { "type": "integer", "minimum": 1, "maximum": 12 },
    "meals": { "type": "array", "minItems": 1, "items": { "enum": ["colazione", "pranzo", "cena", "spuntino"] } },
    "season": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["from", "to"],
          "properties": { "from": { "type": "string", "pattern": "^\\d\\d-\\d\\d$" }, "to": { "type": "string", "pattern": "^\\d\\d-\\d\\d$" } }
        }
      ]
    },
    "active": { "type": "boolean" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["week", "day", "meal"],
        "properties": {
          "week": { "type": "integer", "minimum": 1 },
          "day": { "type": "integer", "minimum": 1, "maximum": 7, "description": "1 = Monday … 7 = Sunday" },
          "meal": { "enum": ["colazione", "pranzo", "cena", "spuntino"] },
          "recipe": { "type": ["string", "null"] },
          "title": { "type": ["string", "null"], "description": "The recipe's title, used when the id is not found." },
          "text": { "type": "string", "description": "A dish without a recipe (e.g. \"Pizza fuori\")." },
          "servings": { "type": ["number", "null"], "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
