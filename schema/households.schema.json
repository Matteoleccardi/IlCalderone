{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/households.json (calderone-households/1)",
  "type": "object",
  "required": ["format", "households"],
  "properties": {
    "format": {"const": "calderone-households/1"},
    "households": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "members"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "created": {"type": "string"},
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["user", "role"],
              "properties": {"user": {"type": "string"}, "role": {"enum": ["owner", "member"]}}
            }
          }
        }
      }
    }
  }
}
