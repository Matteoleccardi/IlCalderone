{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/meallog/<userId>/<YYYY-MM>.json (calderone-meallog/1)",
  "type": "object",
  "required": ["format", "entries"],
  "properties": {
    "format": {"const": "calderone-meallog/1"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "day", "meal", "title"],
        "properties": {
          "id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-[a-f0-9]+$"},
          "day": {"type": "string", "format": "date"},
          "meal": {"enum": ["colazione", "pranzo", "cena", "spuntino"]},
          "recipe": {"type": ["string", "null"]},
          "title": {"type": "string", "description": "Recipe title snapshot, or free text."},
          "servings": {"type": ["number", "null"]},
          "note": {"type": "string"},
          "created": {"type": "string"}
        }
      }
    }
  }
}
