{
  "name": "ilcalderone-web",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/logos.mjs && ng serve",
    "build": "node scripts/logos.mjs && ng build && node scripts/publish.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/check-i18n.mjs && ng test --watch=false",
    "test:watch": "ng test",
    "api": "php -S 127.0.0.1:8080 -t ../public ../public/api/router-dev.php",
    "check-i18n": "node scripts/check-i18n.mjs",
    "logos": "node scripts/logos.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "rxjs": "~7.8.0",
    "three": "^0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@fontsource-variable/literata": "^5.3.0",
    "@types/three": "^0.186.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8"
  },
  "license": "MIT"
}
