# Private data (accounts, recipes, photos, sessions) — never commit
public/data/*
!public/data/.htaccess
!public/data/index.php
public/api/config.local.php

# Angular build output published into public/ (rebuild with: cd web && npm run build)
public/*.js
public/*.css
public/*.html
public/*.svg
public/*.png
public/*.webmanifest
public/sw.js
public/*.ico
public/media/
public/logos/
public/.build-manifest.json
public/3rdpartylicenses.txt
public/prerendered-routes.json

# Personal starter recipes transcribed from a commercial app: not redistributable
seed/

# Releases made by deploy.sh (may contain private data with --with-data)
release/

# Agent work folders: recipes being imported, generated menus and exports
inbox/
exports/

# Old v0.1 data
legacy/data/

# Tooling
node_modules/
web/dist/
web/public/logos/logos.json
web/.angular/
__pycache__/
.pytest_cache/
*.pyc
.DS_Store

# server backups made by deploy-altervista.sh (accounts, settings): never commit
backups/
public/api/BUILD
